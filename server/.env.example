# --- required ---
API_TOKEN=change-me-to-a-long-random-string
POSTGRES_PASSWORD=readerapp

# --- AI providers ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Jev (TypeSafe AI) typed verdicts; optional, falls back to Claude Haiku
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
# Input-only billing; no fixed per-call fee or output charge.
JEV_PRICE_PER_MTOK_INPUT=0.042

# --- optional source credentials ---
# MyAnimeList API v2 client id; MAL source is skipped when unset
MAL_CLIENT_ID=

# --- spend cap (USD per calendar month, all providers) ---
MONTHLY_AI_BUDGET_USD=5

# --- tuning (defaults shown) ---
# HYDE_MODEL=claude-haiku-5-5
# RERANK_MODEL=claude-sonnet-5-5
# VOYAGE_MODEL=voyage-4-large
# CRAWL_MIN_DELAY_SECONDS=3
# CRAWL_INTERVAL_HOURS=24
# LINK_MAX_NOVELS=50000
# LINK_MAX_LISTING_PAGES=5000
# Opt-in recurring refresh (OFF when empty): comma-separated listing URLs, each re-crawled as a site job at most every
# LINK_REFRESH_HOURS. Novels an earlier job already completed are skipped, so only new ones cost fetches.
# LINK_REFRESH_URLS=https://example.com/new-novel,https://example.com/hot-novel
# LINK_REFRESH_HOURS=24
# LINK_REFRESH_CHAPTERS_PER_NOVEL=3
# Scheduled crawling is OFF by default; opt in per source (manual triggers always work):
# ENABLED_SOURCES=syosetu,anilist,mangaupdates,mal
# CRAWLER_CONTACT=you@example.com
# API_BIND=127.0.0.1
